# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cmes_requisitions

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRY=24h

# Crypto Keys (auto-generated if not set)
ECDSA_PRIVATE_KEY_PATH=./keys/ecdsa-private.pem
ECDSA_PUBLIC_KEY_PATH=./keys/ecdsa-public.pem

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
