# Server
PORT=3001
NODE_ENV=development

# Database (TiDB / MySQL)
# Option A: full connection string
DATABASE_URL=mysql://user:password@host:4000/cmes_requisitions
# Option B: individual vars (avoids URL encoding issues with special chars in password)
# DB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxx.root
# DB_PASSWORD=your-password
# DB_NAME=cmes_requisitions
# DB_SSL=true

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRY=24h

# Crypto Keys (auto-generated if not set)
ECDSA_PRIVATE_KEY_PATH=./keys/ecdsa-private.pem
ECDSA_PUBLIC_KEY_PATH=./keys/ecdsa-public.pem

# SMTP (required — server crashes on startup if unset)
SMTP_HOST=smtp.yourmail.com
SMTP_PORT=465
SMTP_USER=notifications@yourmail.com
SMTP_PASS=your-smtp-password
SMTP_FROM=notifications@yourmail.com

# Admin seed password (used in production seeding; defaults to 'password123' if unset)
# ADMIN_PASSWORD=change-this-to-a-strong-password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000